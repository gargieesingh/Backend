<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Document</title>
    <link rel="stylesheet" href="/stylesheets/src/output.css">
</head>
<body>
    <div class="w-screen h-screen bg-zinc-900 text-white p-10 overflow-auto">
        <nav class="mb-10">
            <a href="/" class="text-blue-600 hover:underline">Back to Home</a>
        </nav>

        <h1 class="text-3xl font-bold mb-1">ALL USERS</h1>
        <hr class="mb-3">
        <div class="users h-[100%] w-full flex flex-row flex-wrap gap-5">
        <% if(allUsers.length >0) {%>
           <% allUsers.forEach(user => { %>
                <div class="user h-90 w-60 bg-zinc-800 rounded-xl p-2">

                    <div class="h-[70%] w-full rounded-xl mb-2">
                        <img src="<%= user.image %>" class="rounded-xl w-full h-full object-top object-cover">
                    </div>

                    <p class="name font-bold"><%= user.name %></p>

                    <p class="email text-gray-400"><%= user.email %></p>

                    <div class="controls flex justify-between my-5">
                        <a href="/edit/<%= user._id %>" class="edit text-white  bg-zinc-600 rounded-xs px-2 hover:scale-95 cursor-pointer">Edit User</a>

                        <a href="/delete/<%= user._id %>" class="delete bg-red-900 text-white rounded-xs px-2 hover:scale-95 cursor-pointer">Delete User</a>

                    </div>
            </div>
           <% })%> 
        <% } else{ %>
            <p class="text-gray-400 italic ">No users here!</p>
        <% } %>
        </div>
    </div>

</body>
</html>